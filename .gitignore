# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Project CLI binary (built into repo root and bin/). Never commit these —
# release artifacts come from the release pipeline, not the working tree.
/portfolio
/bin/portfolio

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Context packs
.context-pack/

# Requirements
.requirements/

# Requirements reviews
.requirements-review/

# Test cases
.test-cases/

# Guidelines
.guidelines/

# Architecture
.architecture/

# Editor/IDE
# .idea/
# .vscode/

# AI coding assistant configs
.agents/
.claude/
.continue/
.forge/
.kilocode/
.windsurf/

# Skills lock
skills-lock.json

# Supabase (unused)
supabase/

# Pipeline artifacts (archive directory itself tracked, contents dynamic)
# .pipeline/
